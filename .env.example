# Copy this file to .env and fill in real values. NEVER commit .env itself.

# Secret key required in the X-Admin-Key header for /admin/* routes.
# Generate a strong one, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=change-me-to-a-long-random-string

# Which model file to load at startup (filename inside trained_models/)
MODEL_FILENAME=model_v1.pt

# Force device selection: "cuda", "cpu", or leave blank for auto-detect
DEVICE_OVERRIDE=
